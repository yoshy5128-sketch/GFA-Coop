{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "fluid": true,
  "functions": {
    "api/p2p-signal.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/p2p-signal",
